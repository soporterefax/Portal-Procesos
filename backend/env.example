# ===== Seguridad =====
# Cambia ambos valores antes de publicar en Azure.
SECRET_KEY=cambia-esta-clave
JWT_SECRET_KEY=cambia-esta-clave-jwt
JWT_EXP_MINUTES=480

# ===== Desarrollo local =====
# Si DATABASE_URL y DB_HOST quedan vacíos, se usa backend/procesos.db (SQLite).
DATABASE_URL=

# ===== Azure Database for MySQL Flexible Server =====
# Recomendado: usa estas variables separadas en App Service Configuration.
DB_HOST=
DB_PORT=3306
DB_NAME=portal_procesos
DB_USER=
DB_PASSWORD=
DB_SSL=true

# ===== Frontends autorizados =====
# Más adelante añade: https://TU-USUARIO.github.io
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
